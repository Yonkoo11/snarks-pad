# /etc/__INSTANCE__/engine.env  (root:__INSTANCE__ 0640)  NON-secret settings: modes, addresses, paths. Secrets go in secrets.env.
PAD_MODE=devnet
PAD_DB_FILE=/var/lib/__INSTANCE__/data/devnet.sqlite
PAD_PAUSE_FILE=/var/lib/__INSTANCE__/data/PAUSED
PAD_KEEPER_HEALTH_LOG=/var/lib/__INSTANCE__/data/keeper-health.log
# Coin images and metadata JSON the API writes and Caddy serves (contract v2.7). PUBLIC_BASE_URL is the address they are served from, https,
# no path: ops/remote-setup.sh fills it from /etc/caddy/snarks-sites.env when it is empty and ops/switch-live.sh moves it with the names.
PUBLIC_DIR=/var/lib/__INSTANCE__/public
PUBLIC_BASE_URL=
KEEPER_KEYPAIR_PATH=/etc/__INSTANCE__/keys/keeper-devnet.json
# devnet only: the stand-in ZEC mint, the multisig, its vault (fee claimer) and the config, copied from engine/data/devnet.vars on the Mac
DEVNET_QUOTE_MINT=
SQUADS_MULTISIG=
FEE_CLAIMER_PUBKEY=
DBC_CONFIG_ID=
# Zcash: the treasury wallet and its age identity (the identity is a PATH; the file lives in /etc/__INSTANCE__/keys)
ZCASH_LIGHTWALLETD=zecrocks
ZCASH_DEVTOOL_BIN=/opt/snarks/bin/zcash-devtool
ZCASH_DEVTOOL_SHA256=
TREASURY_WALLET_DIR=/var/lib/__INSTANCE__/zcash/treasury
TREASURY_IDENTITY_FILE=/etc/__INSTANCE__/keys/treasury.identity.age
TREASURY_ZCASH_ADDRESS=
# devnet only: the testnet wallet that pays the simulated swap
DEVNET_ZCASH_FUNDING_DIR=/var/lib/__INSTANCE__/zcash/funding
DEVNET_ZCASH_FUNDING_IDENTITY=/etc/__INSTANCE__/keys/funding.identity.age
# devnet faucet, optional (SOL; plain decimals 0.003..1, anything else stops startup): what one fill pays, and what the faucet key keeps back
# PAD_FAUCET_SOL=0.02
# PAD_FAUCET_MIN_RESERVE_SOL=0.01
# RPC pacing, optional: the most calls per second this process starts, and the most getProgramAccounts calls per second (unset or 0: no cap). Set both when the
# RPC provider has a per-second cap of its own. The API and the keeper each pace themselves, so their caps add up: QuickNode's free plan allows 15 and 3, so 7 and 1.
# PAD_RPC_MAX_PER_SECOND=7
# PAD_RPC_SCAN_MAX_PER_SECOND=1
# backups: the owner's age PUBLIC key (the matching identity stays off the server); optional rsync target
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=
