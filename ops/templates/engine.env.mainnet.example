# /etc/__INSTANCE__/engine.env  (root:__INSTANCE__ 0640)  NON-secret settings: modes, addresses, paths. Secrets go in secrets.env.
# MAINNET, STAGED. ops/MAINNET-RUNBOOK.md section 2 is the reference for every line; nothing here is a launch value until its gates are ticked.
# Which instance the backup and health scripts act on (they default to the devnet instance without it), and the API's own port:
PAD_INSTANCE=__INSTANCE__
PAD_MODE=mainnet
PAD_API_PORT=__PORT__
PAD_DB_FILE=/var/lib/__INSTANCE__/data/mainnet.sqlite
PAD_PAUSE_FILE=/var/lib/__INSTANCE__/data/PAUSED
PAD_KEEPER_HEALTH_LOG=/var/lib/__INSTANCE__/data/keeper-health.log
# Coin images and metadata JSON the API writes and Caddy serves (contract v2.7). PUBLIC_BASE_URL is the address they are served from and is
# written on chain in every coin's metadata uri for good: https, no path. The API refuses to start on mainnet without it. ops/remote-setup.sh
# fills it from Caddy's sites file (the live name) when it is empty; check it before the first launch.
PUBLIC_DIR=/var/lib/__INSTANCE__/public
PUBLIC_BASE_URL=
# Kill switch, on while staged (the PAUSED file in the data directory is the second lock). At launch: remove this line AND
# the PAUSED file, then restart both units (runbook section 4). Any value but 0/false/no/off pauses.
PAYOUTS_PAUSED=1
# The keeper key is made ON this server by ops/keys-setup.sh and never copied in.
KEEPER_KEYPAIR_PATH=/etc/__INSTANCE__/keys/keeper-mainnet.json
# Set at launch from the owner's signing steps (runbook 3a, 3b). Left empty until then: empty means unset to the engine.
SQUADS_MULTISIG=
FEE_CLAIMER_PUBKEY=
DBC_CONFIG_ID=
# NEVER set on mainnet, the engine refuses to start with any of them: DBC_FEE_BPS, DBC_INITIAL_MCAP_ZEC, DBC_MIGRATION_MCAP_ZEC
# Zcash mainnet: a NEW wallet made on this server and its age identity (the identity is a PATH; the file lives in /etc/__INSTANCE__/keys)
ZCASH_LIGHTWALLETD=zec.rocks:443
# manual fallback, same operator (TLS answered from this server on 2026-10-05, never synced against): na.zec.rocks:443  eu.zec.rocks:443
ZCASH_DEVTOOL_BIN=/opt/snarks/bin/zcash-devtool
ZCASH_DEVTOOL_SHA256=
TREASURY_WALLET_DIR=/var/lib/__INSTANCE__/zcash/treasury-main
TREASURY_IDENTITY_FILE=/etc/__INSTANCE__/keys/treasury.identity.age
TREASURY_ZCASH_ADDRESS=
# Canary cap for week one (audit/STRESS-REPORT.md "Mainnet canary plan"): 0.1 ZEC per epoch swap
PAD_SWAP_MAX_ZATS=10000000
# The RPC plan, gate G13 (Helius free: 1,000,000 credits a month, getProgramAccounts 10 credits, every other call 1). Each process paces itself at these caps; a coin's
# holder count and holders table read the chain at most once per TTL; the keeper warns when the projected month reaches 50% and 80% of the credits.
PAD_RPC_MAX_PER_SECOND=8
PAD_RPC_SCAN_MAX_PER_SECOND=1
PAD_HOLDER_COUNT_TTL_MS=600000
PAD_RPC_MONTHLY_CREDITS=1000000
# The team's Solana wallet (owner decision 2026-10-05): the keeper sends the team share there, one payout row per epoch.
TEAM_WALLET=9KzyvgydD7mJACY1QKALd6gdapnJ2WmMzCQMFrETsssj
# Set at launch: an ISO time at least one sample window after the keeper starts. Empty means one epoch cadence (48 h)
# after the keeper first starts (src/scheduler.ts reads an empty value as unset).
PAD_FIRST_EPOCH_AT=
# backups: the owner's age PUBLIC key (the matching identity stays off the server); optional rsync target
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=
