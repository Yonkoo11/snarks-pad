# /etc/__INSTANCE__/secrets.env  (root:root 0600; systemd reads it as root, the service user never opens the file)
# Filled by ops/push-secrets.sh from the owner's private files on the Mac, over ssh stdin: never typed, never on a command line.
# The keyed mainnet RPC URL: the URL is itself the secret (the engine masks "api-key=..." in everything it prints)
SOLANA_MAINNET_RPC=
# the same key on its own, so the engine's log masking also catches it when it appears bare
HELIUS_API_KEY=
# optional: a webhook that receives a line when the health check fails (Discord/Slack-style JSON {"content": "..."})
ALERT_WEBHOOK_URL=
# optional: Telegram alerts, the health check's message to the owner's bot. The token comes from @BotFather; ops/telegram-setup.sh finds the chat number. Both are needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
